<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.home-media.broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/Developer/home-media-control/.venv/bin/home-media-broker</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8744</string>
    <string>--config</string>
    <string>/Users/YOU/.config/home-media/homes.yaml</string>
    <string>--codex-fallback</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOU</string>
    <key>USER</key>
    <string>YOU</string>
    <key>LOGNAME</key>
    <string>YOU</string>
    <key>HOME_MEDIA_BROKER_TOKEN_FILE</key>
    <string>/Users/YOU/.config/home-media/broker-token</string>
    <key>HOME_MEDIA_PREWARM_ROOMS</key>
    <string>living_room</string>
    <key>HOME_MEDIA_PYMOBILEDEVICE3_PYTHON</key>
    <string>/Users/YOU/Developer/home-media-control/.venv-pmd3/bin/python</string>
    <key>HOME_MEDIA_CODEX_BIN</key>
    <string>/Applications/ChatGPT.app/Contents/Resources/codex</string>
    <key>HOME_MEDIA_AIRPLAY_CAPTURE_CONFIG</key>
    <string>/Users/YOU/.config/home-media/airplay-capture.json</string>
    <key>HOME_MEDIA_FRAME_STREAM_DIR</key>
    <string>/Users/YOU/Library/Application Support/Home Media/frames</string>
    <key>HOME_MEDIA_FRAME_STREAM_MAX_AGE_S</key>
    <string>3</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
