*.pem
*.key

# Generated Apple Shortcut artifacts (signed files may contain import answers)
shortcuts/*.shortcut
shortcuts/*.plist
shortcuts/*_processed.cherri
dist/*.shortcut

# Local private runtime / live reports (may contain LAN details)
docs/live/
.home-media/

# Private discovery inventory (LAN addresses / stable IDs) — never publish
discovery/NETWORK_SNAPSHOT.md
discovery/NETWORK_SNAPSHOT.private.md
discovery/devices.yaml
discovery/*.private.yaml

# Calibration screenshots / recipe fixtures may contain profile/viewing data
.private/
fixtures/private/

# SwiftPM products are rebuilt and ad-hoc signed on the target Mac.
native/**/.build/
native/**/.swiftpm/

# Agent configuration and Apple signing/renewal artifacts stay on the local bridge.
agent.yaml
wda-signing.xcconfig
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
*.xctestrun
*.xcresult/
*.ipa
*.app/
renewal-private/
capture-output/
